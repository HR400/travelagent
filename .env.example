# Environment Configuration Template for ReAct Travel Agent
# Copy this file to .env and fill in your actual values

# =============================================================================
# API KEYS (Required)
# =============================================================================

# OpenAI API Key (for GPT models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Groq API Key (for faster, cheaper models)
# Get from: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (for web search functionality)
# Get from: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# API CONFIGURATION (Optional)
# =============================================================================

# Custom OpenAI-compatible API endpoint (e.g., for local LLMs or proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model override (default: gpt-4o-mini for OpenAI, qwen/qwen3.8-27b for Groq)
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# BUDGET SETTINGS (Optional)
# =============================================================================

# Maximum trip budget in USD (default: 800.0)
# HARD_CAP=800.0

# =============================================================================
# REACT LOOP SETTINGS (Optional)
# =============================================================================

# Maximum number of ReAct reasoning steps (default: 15, range: 1-100)
# MAX_STEPS=15

# Maximum tokens in LLM response (default: 800)
# MAX_TOKENS=800

# Temperature for LLM responses (default: 0.2, range: 0-2)
# TEMPERATURE=0.2

# Number of recent messages to keep in context window (default: 6)
# MAX_CONTEXT_WINDOW=6

# =============================================================================
# TIMEOUT & RETRY SETTINGS (Optional)
# =============================================================================

# API request timeout in seconds (default: 30, range: 5-300)
# API_TIMEOUT=30

# Maximum retry attempts for failed API calls (default: 3)
# MAX_RETRIES=3

# Exponential backoff multiplier (default: 2.0)
# RETRY_BACKOFF_FACTOR=2.0

# Initial delay before first retry in seconds (default: 1.0)
# INITIAL_RETRY_DELAY=1.0

# =============================================================================
# LOGGING SETTINGS (Optional)
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO

# Log format: json (for production) or text (for development) (default: json)
# LOG_FORMAT=json

# =============================================================================
# HEALTH CHECK SETTINGS (Optional)
# =============================================================================

# Enable health check endpoint (default: true)
# HEALTH_CHECK_ENABLED=true

# =============================================================================
# MONGODB SETTINGS (Optional)
# =============================================================================

# MongoDB connection URI (default: mongodb://localhost:27017)
# For MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/
# MONGO_URI=mongodb://localhost:27017

# MongoDB database name (default: travelagent)
# MONGO_DB_NAME=travelagent

# MongoDB connection timeout in milliseconds (default: 2000)
# MONGO_TIMEOUT_MS=2000
